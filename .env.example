# Settings for football-results-dashboard.
#
# Copy to .env (ignored by git) and fill in your own values. This file holds names
# and descriptions only: never put a real value, key, token, or connection string here.
# Every setting has a safe default or is only needed for Azure. There is no API-key
# setting: the app authenticates to Azure with Microsoft Entra ID only.

# --- Data --------------------------------------------------------------------------
# Folder with the raw Kaggle downloads (see data/README.md). Default: data
FOOTBALL_DATA_DIR=
# Folder for the local curated store written by ingest. Default: .local/curated
CURATED_DIR=
# Where services load the curated store from: local | blob. Default: local
CURATED_SOURCE=
# Blob endpoint of your private storage account, e.g. https://<account>.blob.core.windows.net
STORAGE_ACCOUNT_URL=
# Blob containers for raw uploads and curated versions. Defaults: raw, curated
RAW_CONTAINER=
CURATED_CONTAINER=

# --- Services ----------------------------------------------------------------------
# Base URL the web service uses to reach insights. Default: http://localhost:8081
INSIGHTS_URL=
# Listening ports. Defaults: 8080 (web), 8081 (insights)
WEB_PORT=
INSIGHTS_PORT=
# Per-client request limits for the public web service. Defaults: 60 pages, 6 questions per minute.
# The AKS and ACA deployments raise the page limit to 3600 so the bounded load test is not throttled.
WEB_RATE_LIMIT_PER_MINUTE=
ASK_RATE_LIMIT_PER_MINUTE=
# Log level: DEBUG | INFO | WARNING. Default: INFO
LOG_LEVEL=

# --- Microsoft Foundry -------------------------------------------------------------
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment that serves answers. Switching models is this one setting. Default: gpt-6-astra
AI_MODEL_DEPLOYMENT=
# Model reset returns to this deployment. Default: gpt-6-astra
DEFAULT_MODEL_DEPLOYMENT=
# Deployments the evaluation and the model switch may use, comma separated. Default: gpt-6-astra,gpt-6-sol
AI_ALLOWED_DEPLOYMENTS=
# Reasoning effort sent to the model. Default: low
AI_REASONING_EFFORT=
# Narrative mode: live (call the model) | cached (labeled replays only) | off. Default: live when an endpoint is set, else off
AI_NARRATIVE_MODE=
# Bounds per answer. Defaults: 6 tool calls, 1200 output tokens, 45 seconds, 300-character questions
AI_MAX_TOOL_CALLS=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_SECONDS=
QUESTION_MAX_CHARS=
# Folder of labeled cached narratives used when AI_NARRATIVE_MODE=cached. Default: .local/narratives
NARRATIVE_CACHE_DIR=

# --- Identity ------------------------------------------------------------------------
# Client ID of the user-assigned managed identity (set by the ACA deployment; AKS workload identity injects it).
AZURE_CLIENT_ID=
# Local Docker Compose only: path inside the container to a short-lived token file written by
# `demo up -LiveModel` (bash: --live-model). Leave empty everywhere else.
AZURE_TOKEN_FILE=

# --- Telemetry -----------------------------------------------------------------------
# Application Insights connection string. The resource has local authentication disabled,
# so ingestion also needs an Entra token. Leave empty for local-only telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Service name for traces; each deployment sets it (web, insights, ingest).
OTEL_SERVICE_NAME=
# Folder for local JSON traces. Default: .local/traces
LOCAL_TRACE_DIR=

# --- Environment badge (set by deployment configuration, never hardcoded) -------------
# Platform label: Local | AKS | ACA. Default: Local
PLATFORM_NAME=
# Azure region label, e.g. westus3. Default: empty
PLATFORM_REGION=
# Image digest the deployment runs, e.g. sha256:... Default: empty (shown as "local build")
IMAGE_DIGEST=

# --- Operator scripts (demo/scripts) -------------------------------------------------
# Your subscription, region, and resource group.
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=
AZURE_RESOURCE_GROUP=
# Foundry resource and project names (the resource name is also its custom subdomain).
FOUNDRY_RESOURCE_NAME=
FOUNDRY_PROJECT_NAME=
# Globally unique names: registry and storage allow lowercase letters and digits only.
ACR_NAME=
STORAGE_ACCOUNT_NAME=
LOG_ANALYTICS_NAME=
APPINSIGHTS_NAME=
AKS_CLUSTER_NAME=
# AKS Kubernetes version. Default: 1.36
AKS_KUBERNETES_VERSION=
ACA_ENVIRONMENT_NAME=
# Container app and job names (at most 32 characters each).
ACA_WEB_APP_NAME=
ACA_INSIGHTS_APP_NAME=
ACA_INGEST_JOB_NAME=
# One user-assigned identity per service per platform, each with only the roles it needs.
AKS_WEB_IDENTITY_NAME=
AKS_INSIGHTS_IDENTITY_NAME=
AKS_INGEST_IDENTITY_NAME=
ACA_WEB_IDENTITY_NAME=
ACA_INSIGHTS_IDENTITY_NAME=
ACA_INGEST_IDENTITY_NAME=
# Addresses allowed to reach the public web endpoints, comma-separated CIDRs. `demo allow-ip` sets your current IP.
ALLOWED_CIDRS=
# Image tag to build and deploy. Default: the short git commit
IMAGE_TAG=
# Monthly budget in USD, the address that receives budget alerts, and the budget start (first of a month).
# Default start: the first day of the current month.
BUDGET_AMOUNT=
BUDGET_CONTACT_EMAIL=
BUDGET_START_DATE=
# Object ID of the operator who gets data-plane roles. Default: read from your current az login.
OPERATOR_PRINCIPAL_ID=
# Tags applied to every resource. PROJECT_TAG default: football-insights
PROJECT_TAG=
EVENT_DATE=
TEARDOWN_DATE=
# Folder where evidence-writing scripts save output. Default: .local/evidence
EVIDENCE_DIR=
# Optional web URL overrides. By default the scripts read them from the AKS gateway and the ACA ingress;
# the parity test compares the two when both are set.
AKS_WEB_URL=
ACA_WEB_URL=

# --- Presenter machine --------------------------------------------------------------
# Optional version pins checked by `demo preflight`. Leave empty to report actual versions only.
PINNED_AZ=
PINNED_KUBECTL=
PINNED_DOCKER=
PINNED_COPILOT_APP=

# --- Set by the scripts at run time; leave these empty ------------------------------------
# From deployment outputs: registry login server and the AKS workload identity client IDs.
ACR_LOGIN_SERVER=
AKS_WEB_CLIENT_ID=
AKS_INSIGHTS_CLIENT_ID=
AKS_INGEST_CLIENT_ID=
# From .local/deploy/digests.json (demo build-push) or the local build (demo up): the image digests to run.
WEB_IMAGE_DIGEST=
INSIGHTS_IMAGE_DIGEST=
INGEST_IMAGE_DIGEST=
# Full image references Docker Compose runs with demo up -FromRegistry (registry/name@digest).
WEB_IMAGE=
INSIGHTS_IMAGE=
INGEST_IMAGE=
# Absolute path of the data folder that Docker Compose mounts read-only (demo up sets it from FOOTBALL_DATA_DIR).
FOOTBALL_DATA_DIR_HOST=
# demo aca-deploy sets false for its first pass (environment and ingest job only), then true for the apps.
ACA_DEPLOY_APPS=
