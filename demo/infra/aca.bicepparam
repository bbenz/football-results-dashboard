using './aca.bicep'

param location = readEnvironmentVariable('AZURE_LOCATION')
param projectTag = readEnvironmentVariable('PROJECT_TAG')
param eventDateTag = readEnvironmentVariable('EVENT_DATE')
param teardownDateTag = readEnvironmentVariable('TEARDOWN_DATE')
param acaEnvironmentName = readEnvironmentVariable('ACA_ENVIRONMENT_NAME')
param logAnalyticsName = readEnvironmentVariable('LOG_ANALYTICS_NAME')
param webAppName = readEnvironmentVariable('ACA_WEB_APP_NAME')
param insightsAppName = readEnvironmentVariable('ACA_INSIGHTS_APP_NAME')
param ingestJobName = readEnvironmentVariable('ACA_INGEST_JOB_NAME')
param acaWebIdentityName = readEnvironmentVariable('ACA_WEB_IDENTITY_NAME')
param acaInsightsIdentityName = readEnvironmentVariable('ACA_INSIGHTS_IDENTITY_NAME')
param acaIngestIdentityName = readEnvironmentVariable('ACA_INGEST_IDENTITY_NAME')
param registryLoginServer = readEnvironmentVariable('ACR_LOGIN_SERVER')
param webImageDigest = readEnvironmentVariable('WEB_IMAGE_DIGEST')
param insightsImageDigest = readEnvironmentVariable('INSIGHTS_IMAGE_DIGEST')
param ingestImageDigest = readEnvironmentVariable('INGEST_IMAGE_DIGEST')
param applicationInsightsConnectionString = readEnvironmentVariable('APPLICATIONINSIGHTS_CONNECTION_STRING')
param storageAccountUrl = readEnvironmentVariable('STORAGE_ACCOUNT_URL')
param foundryProjectEndpoint = readEnvironmentVariable('FOUNDRY_PROJECT_ENDPOINT')
param aiModelDeployment = readEnvironmentVariable('AI_MODEL_DEPLOYMENT')
param aiAllowedDeployments = readEnvironmentVariable('AI_ALLOWED_DEPLOYMENTS')
param webAllowedCidrs = split(readEnvironmentVariable('ALLOWED_CIDRS'), ',')
param deployApps = readEnvironmentVariable('ACA_DEPLOY_APPS', 'true') == 'true'
